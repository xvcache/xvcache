# /etc/cloudflared/xvcache-tunnel.env — jeton du tunnel Cloudflare "xvcache-mcp" (géré à distance).
# Droits obligatoires : root:root, 0600. Ne JAMAIS commiter ni copier le vrai jeton ailleurs.
# Le jeton se copie depuis le tableau de bord Cloudflare (Zero Trust → Networks → Tunnels →
# xvcache-mcp → Configure → commande d'installation : la longue chaîne après "service install").
# Les routes publiques (mcp.xvcache.com → http://127.0.0.1:8787 : /mcp, /healthz, /pdf/*.pdf)
# sont configurées côté Cloudflare, pas ici.
CLOUDFLARE_TUNNEL_TOKEN=VOTRE_TOKEN_TUNNEL_CLOUDFLARE
