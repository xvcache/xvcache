# XVcache — serveur MCP distant (xvcache-remote) — modèle d'environnement.
# Copié par install-or-update.sh vers /etc/xvcache/xvcache-mcp.env (root:xvcache, 0640)
# UNIQUEMENT s'il n'existe pas encore. Ne jamais commiter le fichier rempli.
# Ce modèle ne contient AUCUN secret : les lignes secrètes sont vides et commentées.

# --- Réseau : toujours en local, le tunnel Cloudflare est le seul accès public ---
XVCACHE_REMOTE_HOST=127.0.0.1
XVCACHE_REMOTE_PORT=8787
# URL publique utilisée dans les liens PDF (pdf_url, valides 24 h)
XVCACHE_PUBLIC_URL=https://mcp.xvcache.com

# --- Données (preuves, lots, abonnements hachés). Géré par systemd (StateDirectory). ---
XVCACHE_REMOTE_DATA=/var/lib/xvcache

# --- Horodatage ---
# Les empreintes reçues dans cette fenêtre (ms) partagent UN seul jeton TSA.
XVCACHE_BATCH_WINDOW_MS=2000
# Nouvelle tentative des lots "pending_qualified" (ms) : 300000 = 5 min
XVCACHE_RETRY_MS=300000
# Ancrage OpenTimestamps (Bitcoin, gratuit) en plus du jeton RFC 3161 : on | off
XVCACHE_OTS=on

# Fournisseur TSA pour xvcache-remote : qualified uniquement (qualifié eIDAS, payant au jeton ; un alias historique est aussi accepté). freetsa, custom et off sont refusés au démarrage.
# xvcache-remote refuse de démarrer sans XVCACHE_TSA_USER et XVCACHE_TSA_PASSWORD : aucun repli FreeTSA.
# freetsa n'est autorisé que pour le serveur local (xvcache-mcp).
# Les identifiants sont dans le fichier env du serveur, jamais dans le dépôt.
XVCACHE_TSA_PROVIDER=qualified

# Compte TSA qualifié : à remplir SUR LE VPS / dans le fichier env du serveur, jamais ici :
# XVCACHE_TSA_USER=
# XVCACHE_TSA_PASSWORD=
# Chaîne de confiance : par défaut les certificats publics fournis dans certs/ ; surcharge possible :
# XVCACHE_TSA_CA_FILE=
# XVCACHE_TSA_UNTRUSTED_FILE=

# --- Paiement Stripe (lot L4) ---
# PAS ici : dans /etc/xvcache/stripe.env (root, 0600), voir stripe.env.example.
# Webhook signé reçu sur POST https://mcp.xvcache.com/stripe/webhook.

# --- Tunnel Cloudflare ---
# Le jeton du tunnel (CLOUDFLARE_TUNNEL_TOKEN=VOTRE_TOKEN_TUNNEL_CLOUDFLARE) n'est PAS ici :
# il va dans /etc/cloudflared/xvcache-tunnel.env (root, 0600), lisible par cloudflared seulement.
# Voir cloudflared-tunnel.env.example.

# --- Node ---
NODE_ENV=production
