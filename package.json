{
  "name": "xvcache-mcp",
  "version": "0.2.0",
  "description": "Local MCP server for Markdown vaults: sha256-chained journal with V (intact) / X (modified) verdicts, batched RFC 3161 + OpenTimestamps proofs, one-page PDF certificate. Timestamps are eIDAS-qualified only with your own Certigna account (optional); default FreeTSA is test-only. Paid plans not yet on sale.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "xvcache-mcp": "dist/server.js",
    "xvcache-certificate": "dist/export-certificate.js",
    "xvcache-remote": "dist/remote-server.js"
  },
  "mcpName": "io.github.xvcache/xvcache",
  "files": [
    "dist/server.js",
    "dist/journal.js",
    "dist/verify-journal.js",
    "dist/plans.js",
    "dist/merkle.js",
    "dist/der.js",
    "dist/tsa.js",
    "dist/ots.js",
    "dist/certify.js",
    "dist/env.js",
    "dist/demo-server.js",
    "dist/certificate.js",
    "dist/export-certificate.js",
    "certs/freetsa-cacert.pem",
    "certs/certigna-chain.pem",
    "certs/certigna-untrusted.pem",
    "LICENSE",
    "NOTICE",
    "README.md",
    "TRADEMARK.md",
    "SECURITY.md",
    "server.json",
    "plans.json",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt",
    "scripts/demo-ui.mjs",
    "dist/i18n.js",
    "locales/*.json",
    "fonts/*.ttf",
    "fonts/LICENSE-DejaVu.txt",
    "dist/errors.js",
    "dist/subscriptions.js",
    "dist/witness.js",
    "dist/remote.js",
    "dist/tsa-tokens.js",
    "dist/key-delivery.js",
    "dist/remote-server.js"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/server.js dist/export-certificate.js dist/remote-server.js",
    "start": "node dist/server.js",
    "test": "npm run build && node dist/test-client.js && node --test dist/journal.test.js dist/plans.test.js dist/offer.test.js dist/merkle.test.js dist/certify.test.js dist/env.test.js dist/certify.integration.test.js dist/certificate.test.js dist/certificate-i18n.test.js dist/subscriptions.test.js dist/witness.test.js dist/remote.test.js dist/stripe-webhook.test.js dist/qualification.test.js dist/daily-anchor.test.js dist/key-delivery.test.js",
    "demo:certify": "npm run build && node scripts/demo-certify.mjs",
    "demo:ui": "npm run build && node scripts/demo-ui.mjs",
    "certificate": "npm run build && node dist/export-certificate.js",
    "verify-journal": "node dist/verify-journal.js",
    "start:remote": "node dist/remote-server.js",
    "lint:deploy": "bash -n deploy/hetzner-cx23-cloudflare/install-or-update.sh && bash -n deploy/hetzner-cx23-cloudflare/make-release-archive.sh && bash -n deploy/hetzner-cx23-cloudflare/check-health.sh && bash -n deploy/hetzner-cx23-cloudflare/backup.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "eidas",
    "qualified-timestamp",
    "electronic-timestamp",
    "timestamp",
    "rfc3161",
    "opentimestamps",
    "certigna",
    "proof-of-existence",
    "prior-art",
    "document-integrity",
    "tamper-evident",
    "audit-trail",
    "pdf-certificate",
    "legaltech",
    "lawyers",
    "accountants",
    "auditors",
    "architects",
    "researchers",
    "intellectual-property",
    "compliance",
    "sme",
    "europe",
    "markdown",
    "obsidian",
    "ai-agent",
    "claude",
    "cursor",
    "codex",
    "xvcache",
    "journal",
    "merkle-proof"
  ],
  "author": "Julien Dietemann",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvcache/xvcache.git"
  },
  "homepage": "https://github.com/xvcache/xvcache#readme",
  "bugs": {
    "url": "https://github.com/xvcache/xvcache/issues"
  }
}
